# Optional services, comma-separated: the graph databases of graph storage for Nuxeo (nuxeo-graph-neo4j,
# nuxeo-graph-arcadedb) and OpenArch (openarch-graph-neo4j, openarch-graph-arcadedb), langflow, debug. Compose reads
# this setting from this file. All of them (keep the ones you want):
#COMPOSE_PROFILES=nuxeo-graph-neo4j,nuxeo-graph-arcadedb,openarch-graph-neo4j,openarch-graph-arcadedb,langflow,debug

# Host name the browser uses for this deployment (links, CSRF origins)
KG_SPACES_HOST=localhost

# ----- proxy (compose.proxy.yaml): one entry point -----
PROXY_PORT=8080
# its own paths for the apps behind it, each without a trailing slash (Flexible GraphRAG's /ui/react/, /ui/vue/,
# /ui/angular/ and /api/ stay available as well)
KG_SPACES_ACA_PATH=/kg-spaces-aca
# KG Spaces for Nuxeo; Nuxeo's Web UI actions open it here (compose.nuxeo.yaml writes kgspaces.url from it)
KG_SPACES_NUXEO_PATH=/kg-spaces-nuxeo
FG_REACT_PATH=/fg-react
FG_VUE_PATH=/fg-vue
FG_ANGULAR_PATH=/fg-angular
FG_API_PATH=/fg-api
# the backend the proxy sends /api to: the deployment's container (default http://flexible-graphrag-backend:8000), or
# while developing one running from a checkout on this machine
FG_BACKEND_URL=http://flexible-graphrag-backend:8000
#FG_BACKEND_URL=http://host.docker.internal:8000
# where that backend reaches Nuxeo, server to server (KG Spaces for Nuxeo sends it in nuxeo_config): the
# deployment's container network (default http://nuxeo:8080/nuxeo), or for a backend on this machine Nuxeo's
# own port, as in flexible-graphrag's NUXEO_URL
FG_NUXEO_URL=http://nuxeo:8080/nuxeo
#FG_NUXEO_URL=http://localhost:8081/nuxeo

# ----- OpenArch (compose.openarch.yaml) -----
# Hyland's published image (ghcr.io/hyland/openarch-app-jvm) ...
OPENARCH_VERSION=1.0.44
# ... or one built from source at OPENARCH_GIT_REF (or any commit) by scripts/build-openarch.sh:
OPENARCH_GIT_REF=28f4b8334996cf51720253e488d761fcc4769a06
OPENARCH_IMAGE=kg-spaces/openarch-all-mongodb:28f4b8334996cf51720253e488d761fcc4769a06
# ... or OpenArch's repositories on a graph database (openarch-graph-storage; not the default):
# scripts/build-openarch-graph-storage.sh builds kg-spaces/openarch-graph-storage:<ref>, then
#   OPENARCH_IMAGE=kg-spaces/openarch-graph-storage:<ref>, OPENARCH_GRAPH_BACKEND, and its profile in COMPOSE_PROFILES
OPENARCH_GRAPH_STORAGE_GIT_REF=d3df81f7b3026a067bd6711187667b987ec7cea4
OPENARCH_GRAPH_BACKEND=arcadedb
OPENARCH_PORT=8088
OPENARCH_MONGODB_PORT=27017
# OpenSearch's host ports stay clear of Flexible GraphRAG's Elasticsearch (9200) / Kibana (5601)
OPENARCH_SEARCH_PORT=9204
OPENARCH_SEARCH_DASHBOARDS_PORT=5605
MONGODB_VERSION=7.0.39
OPENSEARCH_VERSION=2.19.6

# ----- Alfresco (compose.alfresco.yaml) -----
ALFRESCO_VERSION=26.2.0
ALFRESCO_SHARE_VERSION=26.2.2
ALFRESCO_TRANSFORM_VERSION=5.4.4
ALFRESCO_BATCH_INDEXING_VERSION=5.8.0
ALFRESCO_ACTIVEMQ_VERSION=6.2.9-jre17-rockylinux8
ALFRESCO_POSTGRES_VERSION=17.9
ACTIVEMQ_CONSOLE_PORT=8161
# STOMP and OpenWire on the host, for a backend run outside Docker (Windows-safe, as in Flexible GraphRAG)
ACTIVEMQ_STOMP_PORT=8613
ACTIVEMQ_OPENWIRE_PORT=8616
ALFRESCO_POSTGRES_PORT=5432
# search engine Alfresco indexes into (default: OpenArch's OpenSearch)
ALFRESCO_SEARCH_HOST=openarch-search
ALFRESCO_SEARCH_PORT=9200

# ----- Nuxeo (compose.nuxeo.yaml) -----
# image built by nuxeo-graph-storage's Dockerfile (Nuxeo and the Web UI from source: long)
NUXEO_GRAPH_STORAGE_GIT_REF=9a8f8261da378b46552dff424289bcb9e9022d7d
NUXEO_GIT_REF=00b5bed6f966941679aa9762c0f5286375902e44
NUXEO_WEBUI_GIT_REF=3ad7fe290f8a186cb490033a22048986997de207
# an image already built instead of building one (then start without --build), e.g.:
NUXEO_IMAGE=nuxeo-graph-storage:local
# repository storage: postgresql (stock), or graph-neo4j / graph-arcadedb (nuxeo-graph-storage)
# Nuxeo's repository on a graph database instead (not the default): graph-neo4j or graph-arcadedb in place of
# postgresql, and its profile in COMPOSE_PROFILES (nuxeo-graph-neo4j or nuxeo-graph-arcadedb), e.g.
#   NUXEO_TEMPLATES=graph-neo4j,sql-audit,opensearch1-search-client
NUXEO_TEMPLATES=postgresql,sql-audit,opensearch1-search-client
NUXEO_PORT=8081
# clear of Flexible GraphRAG's OpenSearch (9201)
NUXEO_SEARCH_PORT=9205
# Kafka on the host, for a backend run outside Docker
NUXEO_KAFKA_PORT=9092
NUXEO_KAFKA_UI_PORT=8092

# ----- Flexible GraphRAG (compose.flexible-graphrag.yaml) -----
# Its databases: the menu flexible-graphrag/docker/docker-compose.kg-spaces.yaml (its own ports, docs/ADVANCED/PORT-MAPPINGS.md),
# their addresses here in flexible-graphrag/docker/.env, which ones it uses in flexible-graphrag.env.
FLEXIBLE_GRAPHRAG_VERSION=0.9.0
# the backend's settings (LLM, embeddings, keys, PG_GRAPH_DB / RDF_GRAPH_DB / VECTOR_DB / SEARCH_DB): start from
# flexible-graphrag.env.sample
FLEXIBLE_GRAPHRAG_ENV_FILE=./flexible-graphrag.env
# data source configs and document state: postgres (postgres-pgvector) or openarch (the OpenArch tree; needs a
# backend from 0.9.0 on, e.g. one built by scripts/build-flexible-graphrag.sh)
#INCREMENTAL_STATE_STORE=postgres
INCREMENTAL_STATE_STORE=openarch
# images of your own instead of the published ones (scripts/build-flexible-graphrag.sh), e.g.:
#FLEXIBLE_GRAPHRAG_BACKEND_IMAGE=kg-spaces/flexible-graphrag-backend:local
#FLEXIBLE_GRAPHRAG_UI_ANGULAR_IMAGE=kg-spaces/flexible-graphrag-ui-angular:local
#FLEXIBLE_GRAPHRAG_UI_REACT_IMAGE=kg-spaces/flexible-graphrag-ui-react:local
#FLEXIBLE_GRAPHRAG_UI_VUE_IMAGE=kg-spaces/flexible-graphrag-ui-vue:local
# dev standalone backend or docker here, not run at same time
BACKEND_PORT=8000
FG_ANGULAR_PORT=4200
FG_REACT_PORT=3000
FG_VUE_PORT=5173
# Langflow, with the langflow profile (COMPOSE_PROFILES above, or --profile langflow)
LANGFLOW_PORT=7860
#FLEXIBLE_GRAPHRAG_LANGFLOW_IMAGE=kg-spaces/flexible-graphrag-langflow:local

# ----- KG Spaces ACA (compose.kg-spaces-aca.yaml) -----
# kg-spaces-aca commit built into the image (from GitHub)
KG_SPACES_ACA_GIT_REF=v0.9.0
# @flexible-graphrag/angular-ui version from npm
KG_SPACES_ACA_LIB_VERSION=0.9.0
KG_SPACES_ACA_PORT=4280
# build from a local checkout instead of GitHub at KG_SPACES_ACA_GIT_REF, as an image of its own:
#   docker compose -p kg-spaces build kg-spaces-aca
#KG_SPACES_ACA_CONTEXT=../kg-spaces-aca
#KG_SPACES_ACA_IMAGE=kg-spaces/kg-spaces-aca:local
# the library from a tarball in the checkout's docker/lib/ instead of npm (an unreleased library)
#KG_SPACES_ACA_LIB_SOURCE=local

# ----- KG Spaces for Nuxeo (compose.kg-spaces-nuxeo.yaml) -----
# the app Web UI's "Add to KG Spaces" opens, and its Web UI add-on (scripts/build-kg-spaces-nuxeo.sh)
KG_SPACES_NUXEO_GIT_REF=v0.9.0
KG_SPACES_NUXEO_PORT=4290
# build from a local checkout instead of GitHub at KG_SPACES_NUXEO_GIT_REF, as an image of its own
#KG_SPACES_NUXEO_CONTEXT=../kg-spaces-nuxeo
#KG_SPACES_NUXEO_IMAGE=kg-spaces/kg-spaces-nuxeo:local
# where Web UI's actions open the app (Nuxeo's kgspaces.url; recreate nuxeo after a change): the deployment's app
# through the proxy (default), or one run with npm start from a kg-spaces-nuxeo checkout
KG_SPACES_NUXEO_URL=http://localhost:8080/kg-spaces-nuxeo/
#KG_SPACES_NUXEO_URL=http://localhost:4300/kg-spaces-nuxeo/
